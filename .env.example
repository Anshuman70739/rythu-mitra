APP_ENV=development
DEMO_MODE=false
SECRET_KEY=
# Required in production so rate limits are shared across worker processes and restarts.
REDIS_URL=
# Set only to the exact trusted proxy hop count from your hosting provider's docs.
TRUSTED_PROXY_HOPS=0
API_READ_RATE_LIMIT=180
API_WRITE_RATE_LIMIT=60
MAX_JSON_BODY_BYTES=1048576
MAX_QUERY_BYTES=4096
DATABASE_URL=sqlite:///data/rythu_mitra.db
DATABASE_PATH=
OPENWEATHER_API_KEY=
# Official daily mandi prices (data.gov.in / AGMARKNET resource). Key stays server-side.
DATA_GOV_IN_API_KEY=
MARKET_DEFAULT_STATE=Telangana
# Optional legacy custom adapter; not needed for the official data.gov.in connector.
MARKET_DATA_API_KEY=
MARKET_DATA_BASE_URL=
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=5242880
MAX_REQUEST_BYTES=27262976
MODEL_DIR=models
SESSION_COOKIE_SECURE=false
DISEASE_CONFIDENCE_THRESHOLD=0.65
MAX_IMAGE_PIXELS=20000000
LOG_LEVEL=INFO
